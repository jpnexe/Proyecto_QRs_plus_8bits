---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import QuickSearch from '../../components/QuickSearch';
import type { SearchableItem } from '../../lib/searchEngine';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const presets = await getCollection('presets');
const searchablePresets: SearchableItem[] = presets.map((p) => ({
  id: p.id,
  title: p.data.name,
  description: p.data.description,
  tag: p.data.tag,
  url: `${base}/presets/${p.id}`,
}));
---

<Layout title="Catálogo de Estilos QR | Proyecto QR Plus">
  <main class="max-w-4xl mx-auto px-4 py-12 space-y-8">
    <div class="flex items-center justify-between border-b-4 border-black pb-4">
      <div>
        <h1 class="text-2xl font-bold pixel-font text-[#F2C94C]">ESTILOS PREDEFINIDOS</h1>
        <p class="text-sm text-zinc-400 font-mono mt-1">
          Búsqueda y catálogo interactivo de presets de códigos QR
        </p>
      </div>
      <a href={`${base}/`} class="pixel-btn px-4 py-2 bg-[#3B82F6] text-white text-xs font-mono uppercase">
        &larr; Volver
      </a>
    </div>

    <QuickSearch client:load items={searchablePresets} />
  </main>
</Layout>
